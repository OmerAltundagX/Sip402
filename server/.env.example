# Address that receives chunk payments (Sip402 demo provider). The server holds no private key.
PROVIDER_ADDRESS=0xbcfA938670a91d54960265F55a016E8EA1442270
# Price tiers as id:Label:priceMON per sip; the first is the default
PRICE_TIERS=fast:Fast:0.0001,smart:Smart:0.0003,pro:Pro:0.0005
WORDS_PER_CHUNK=10
PORT=3001
# Comma-separated web origins allowed to call the API
ALLOWED_ORIGINS=http://localhost:3000
RPC_URL=https://testnet-rpc.monad.xyz
CONTRACT_ADDRESS=0x0654aB49C0AF16c0E660E84A8A879e497095a6D8
STREAM_IDLE_TIMEOUT_MS=300000
# Optional second RPC used when the primary still fails after rate-limit retries
RPC_URL_FALLBACK=
