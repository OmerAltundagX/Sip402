# Agent wallet for `npm run agent`. Create agent/.env with a fresh key via `npm run agent -- --init`.
# Testnet only. agent/.env is gitignored; never commit a real key.
AGENT_PRIVATE_KEY=0x...
# Provider server (default http://localhost:3001)
SIP402_SERVER_URL=http://localhost:3001
# Optional keyed RPC (default https://testnet-rpc.monad.xyz)
RPC_URL=
# Optional second RPC used when the primary still fails after rate-limit retries
RPC_URL_FALLBACK=
